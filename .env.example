# Public canonical origin (set to your verified production domain)
VITE_SITE_URL=https://webakoof-growth-hub.lovable.app
# Server-only HTTPS endpoint that accepts JSON enquiries and returns 2xx after acceptance
ENQUIRY_WEBHOOK_URL=
# Optional bearer credential; never use a VITE_ prefix for secrets
ENQUIRY_WEBHOOK_TOKEN=

# Server-only MySQL CMS. Enable only after schema + seed verification.
CMS_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webakoof
DB_USER=webakoof
DB_PASSWORD=
DB_SSL=false
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:8080
# Persistent filesystem directory. Back up alongside MySQL.
UPLOAD_DIR=uploads
# Used only by npm run cms:admin; remove password after account creation.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
